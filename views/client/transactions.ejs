<%
    const tableData = [
        ['Date', 'Type de transaction', 'Source', 'Destination','Montant ($)']
    ];
    
    if (transactions && transactions.length > 0) {
        transactions.forEach(transaction => {          
            tableData.push([
                transaction.date.toLocaleString(),
                transaction.transaction_type,
                transaction.compte_source,
                transaction.compte_destination,
                transaction.montant
            ]);
        });
    }
    
    const tableHTML = tableHelper(tableData);
%>

<%- include('../layouts/formulaireListe', {
    title: 'Transactions',
    formTitle: "Formulaire de transaction",
    formAction: '/client/transactions',
    formContent: `
        <div>
            <span>* Ces champs sont obligatoires</span>
        </div>  

        <div id="etape1">
            <label class="form-item">Type de transaction: *</label>
            <select class="form-item" id="transactionTypeSelect" name="transactionTypeId">
                <option value="">Sélectionnez un type de transaction pour continuer</option>
                ${transactionTypes && transactionTypes.length > 0 ? transactionTypes.map(type => `
                    <option value="${type.id}" 
                            ${(donnees && donnees.transactionTypeId == type.id) || transactionTypeId == type.id ? 'selected' : ''}>
                        ${type.code}
                    </option>
                `).join('') : ''}
            </select>
        </div> 

        <div id="etape2" style="display:none;">
            <label class="form-item">Source: *</label>
            <select class="form-item" id="sourceSelect" name="compte_source">
                <option value="">Sélectionnez le compte source pour continuer</option>
                ${sources && sources.length > 0 ? sources.map(source => 
                    `<option value="${source.id}" 
                        ${(donnees && donnees.compte_source == source.id) || compteSourceId == source.id ? 'selected' : ''}>
                        ${source.numero}: &nbsp ${source.solde} $
                    </option>`
                ).join('') : ''}
            </select>
        </div>
   
        <div id="etape3" style="display:none;">
            <label class="form-item">Destination: *</label>
            <select class="form-item" id="destSelect" name="compte_destination">
                <option value="">Sélectionnez le compte destination pour continuer</option>
                ${destinations && destinations.length > 0 ? destinations.map(destination => 
                    `<option value="${destination.id}" 
                        ${donnees?.compte_destination == destination.id ? 'selected' : ''}>
                        ${destination.numero}: &nbsp ${destination.solde} $
                    </option>`
                ).join('') : ''}
            </select>
        </div>

        <div id="etape4" style="display:none;">
            <label class="form-item">Montant ($): *</label>
            <input class="form-item" type="number" name="montant" min="0.01" step="0.01" value="${donnees?.montant || ''}">
            <br>
            <button class="form-button" type="submit">Procéder</button>
        </div>
    `,
    listTitle: 'Liste des transactions',
    listContent: tableHTML,
    helperContent: `
        <h4>Transactions autorisées:</h4>
        <div class="transactions-helper">
            
            <div class="transactions-box">
                <h5>Dépôt:</h5>
                <span>DEPOT → CHEQUE</span>
                <span>DEPOT → EPARGNE</span>
                <span>DEPOT → HYPOTHECAIRE</span>
            </div>

            <div class="transactions-box">
                <h5>Retrait:</h5>
                <span>CHEQUE → GUICHET</span>
                <span>EPARGNE → GUICHET</span>
            </div>
                
            <div class="transactions-box">
                <h5>Transfert:</h5>
                <span>CHEQUE → CHEQUE</span>
                <span>CHEQUE → EPARGNE</span>
                <span>CHEQUE → HYPOTHECAIRE</span>
                <span>CHEQUE → MARGE_CREDIT</span>
            </div>

            <div class="transactions-box">
                <h5>Paiement:</h5>
                <span>CHEQUE → FACTURE</span>
            </div>
        </div> 
    `
}); %>
<script src="/scripts/clientTransactions.js"></script>